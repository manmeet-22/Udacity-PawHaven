<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/petDetailImage"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/pet_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/petDetailName"
            style="@style/TextAppearance.Material3.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/petDetailImage" />

        <TextView
            android:id="@+id/petDetailAge"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/petDetailName" />

        <com.udacity.pawhaven.components.SoundPulseView
            android:id="@+id/petDetailPulse"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintBottom_toBottomOf="@id/petDetailPlayPause"
            app:layout_constraintEnd_toEndOf="@id/petDetailPlayPause"
            app:layout_constraintStart_toStartOf="@id/petDetailPlayPause"
            app:layout_constraintTop_toTopOf="@id/petDetailPlayPause" />

        <com.udacity.pawhaven.components.PlayPauseComponent
            android:id="@+id/petDetailPlayPause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@id/petDetailName"
            app:layout_constraintStart_toEndOf="@id/petDetailName"
            app:layout_constraintTop_toTopOf="@id/petDetailName" />

        <TextView
            android:id="@+id/petDetailDescription"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/petDetailAge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adoptButton"
            style="@style/Widget.PawHaven.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/adopt_a_paw"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/petDetailDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
